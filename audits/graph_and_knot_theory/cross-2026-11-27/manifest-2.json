      },
      {
        "line": 22,
        "text": "Takie odwzorowanie nazywamy także osadzeniem;"
      },
      {
        "line": 50,
        "text": "W przypadku osadzenia w płaszczyźnie dokładnie jedna"
      },
      {
        "line": 114,
        "text": "skończonych grafów osadzonych w powierzchni: wokół"
      },
      {
        "line": 119,
        "text": "i są rozłączne. Dla dowolnego osadzenia topologicznego korzystamy"
      },
      {
        "line": 191,
        "text": "W ustalonym osadzeniu dodanie krawędzi nie zmienia"
      },
      {
        "line": 208,
        "text": "osadzonym w sferze, dopuszczającym pętle i krawędzie"
      },
      {
        "line": 242,
        "text": "Niech $G=C_3\\sqcup C_3$ będzie osadzony w płaszczyźnie"
      },
      {
        "line": 370,
        "text": "Dla każdego osadzenia $G$ w sferze równość zachodzi"
      },
      {
        "line": 372,
        "text": "osadzeniu jest cyklem prostym długości $g$."
      },
      {
        "line": 376,
        "text": "Ustalmy osadzenie $G$ w sferze. Jak w dowodzie"
      },
      {
        "line": 514,
        "text": "wierzchołków, osadzonym w $S^2$, z dopuszczalnymi pętlami"
      },
      {
        "line": 564,
        "text": "Skończony graf nieskierowany osadzony w sferze, którego"
      },
      {
        "line": 590,
        "text": "Jego standardowe osadzenie na sferze ma trzy ściany:"
      }
